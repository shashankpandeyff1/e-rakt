  </head>
  <body onload="checkstatus()">
    <header id="header">
      <h1>E-Rakt{{msg}}</h1>
      <ul>
        <li><a href="/"> Home</a></li>
        <li> <a href="/contactus"> Contact Us</a></li>
        <li> <a href="/donors"> Donors</a></li>
          <li><a href="/beadonor"> Be a donor</a></li>
          <li class="login"><a href="/login"> Login</a></li>
          <li class="ma"><a href="/dashboard"> My Account</a></li>
          <li class="logout"><a href="/logout"> Logout</a></li>
      </ul>
    </header>
    <div class="box">
      <div class="b1">
        <img src="/images/bd.jpg" alt="donate blood blud">  <img src="/images/reg.jpg" alt="donate blood blud">
      </div>
      <div class="b2">
        <h1>Donate Blood,Save Lives</h1>
        <p>"Be the reason someone lives—donate blood today. A few minutes of your time can mean a lifetime for someone else. Your blood is precious—share it, save a life. Heroes come in all types—A, B, AB, and O. You don’t need a cape to be a hero—just a generous heart. Every drop matters, and every donor counts. One donation can save up to three lives—make yours count."

</p>
      </div>
    </div><br><br>
    <div class="mhead">
      <h1>Find Donor</h1>
      <div class="line"></div>
    </div>
    <div class="filters">
      <button type="button" name="button" class="filter" onclick="applyfilter()">Apply Filters <img src="/images/filter.png" alt=""> </button><br><br>
      <div class="ff">
      <form class="" action="index.html" method="post">
        <select class="" name="">
          <option value="">-- Select Blood Group --</option>
  <option value="A+">A+</option>
  <option value="A-">A−</option>
  <option value="B+">B+</option>
  <option value="B-">B−</option>
  <option value="AB+">AB+</option>
  <option value="AB-">AB−</option>
  <option value="O+">O+</option>
  <option value="O-">O−</option>
        </select>
        <select class="" name="">
          <option value="">-- Select District --</option>
  <option value="Ahmedabad">Ahmedabad</option>
  <option value="Amreli">Amreli</option>
  <option value="Anand">Anand</option>
  <option value="Aravalli">Aravalli</option>
  <option value="Banaskantha">Banaskantha</option>
  <option value="Bharuch">Bharuch</option>
  <option value="Bhavnagar">Bhavnagar</option>
  <option value="Botad">Botad</option>
  <option value="Chhota Udaipur">Chhota Udaipur</option>
  <option value="Dahod">Dahod</option>
  <option value="Dang">Dang</option>
  <option value="Devbhoomi Dwarka">Devbhoomi Dwarka</option>
  <option value="Gandhinagar">Gandhinagar</option>
  <option value="Gir Somnath">Gir Somnath</option>
  <option value="Jamnagar">Jamnagar</option>
  <option value="Junagadh">Junagadh</option>
  <option value="Kheda">Kheda</option>
  <option value="Kutch">Kutch</option>
  <option value="Mahisagar">Mahisagar</option>
  <option value="Mehsana">Mehsana</option>
  <option value="Morbi">Morbi</option>
  <option value="Narmada">Narmada</option>
  <option value="Navsari">Navsari</option>
  <option value="Panchmahal">Panchmahal</option>
  <option value="Patan">Patan</option>
  <option value="Porbandar">Porbandar</option>
  <option value="Rajkot">Rajkot</option>
  <option value="Sabarkantha">Sabarkantha</option>
  <option value="Surat">Surat</option>
  <option value="Surendranagar">Surendranagar</option>
  <option value="Tapi">Tapi</option>
  <option value="Vadodara">Vadodara</option>
  <option value="Valsad">Valsad</option>
</select><br><br>
        <button type="button" name="button" class="match">Check for Match</button>
      </form></div>
    </div>
    <div class="cards">
      {{#each donor}}
      <div class="card">
        <img src="/images/user.png" alt="find donors">
        <div class="align"><h3> Donor name:<span>{{this.full_name}}</span> </h3></div>
      <div class="align">  <h3> Blood Group:<span>{{this.blood_group}}</span> </h3></div>
        <div class="align"><h3> Location:<span>{{this.district}}</span> </h3></div>
        <button type="button" name="button">Send Request</button>
      </div>{{/each}}<!--<div class="card">
