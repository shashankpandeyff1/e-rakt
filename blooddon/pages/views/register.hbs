      *{
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
html{
  scroll-behavior: smooth;
}
body{
  overflow-x: hidden !important;
  background: #f7fbff;
  color: #17132b;
  font-family: 'Noto Sans', sans-serif;
  -webkit-user-select: none; /* Safari */
  -ms-user-select: none; /* IE 10 and IE 11 */
  user-select: none; /* Standard syntax */
}
::selection{
  background: #fb8574;
  color: #171e2b;
}
::-webkit-scrollbar {
  width: 10px;
  opacity: 0;
}

/* Track */
::-webkit-scrollbar-track {
  box-shadow: inset 0 0 5px grey;
  border-radius: 10px;
}

/* Handle */
::-webkit-scrollbar-thumb {
  background: #fb8574;
  border-radius: 10px;
}
.box{
  width: 100%;
  height: 100vh;
  display: flex;
}
.em{
  color: #fff !important;
}
.b1{
  width: 60%;
  height: 100%;
  background: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}
.b1 h1{
  font-size: 36px;
  color: #fff;
  text-transform: uppercase;
  font-weight: bold;
}
.b1 p{
  font-size: 22px;
  color: #fff;
}
.b1 img{
  width: 100%;
  height: 100% !important;
  border-radius: 2px;
}
.img{
  width: 100%;
  height: 100%;
}
.txt{
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  color: #fff !important;
}
.b2{
  width: 40%;
  height: 100%;
  background: #eb4d4b;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 30px;
}
.b2 p{
  font-weight: bold;
  font-size: 14px;
}
.inp,select,input[type="date"]{
  width: 210px;
  height: 39px;
  border-radius: 3px;
  padding: 3px;
  font-size: 22px;
  color: #282828;
  font-family: monospace;
  border: 2px solid #fff;
  background: #fff;
}
.inp::placeholder,.ta::placeholder,select,input[type="date"]{
  color: #282828;
  font-size: 13px !important;
}
.ta{
  width: 410px;
  height: 80px;
  border-radius: 3px;
  padding: 4px;
  font-size: 22px;
  color: #282828;
  font-family: monospace;
  border: 2px solid #fff;
  background: #fff;
}
.sb{
  width: 160px;
  height: 44px;
  background: #fff;
  border: 2px solid #fff;
  padding: 4px;
  color: #282828;
  font-size: 20px;
  cursor: pointer;
  font-family: 'Noto Sans', sans-serif;
  font-weight: bold;
  border-radius: 3px;
}
::-webkit-file-upload-button {
background: #fff;
color: #fb8574;
border: 2px solid #fff;
}
#selbox{
  width: 210px !important;
  height: 39px;
  border-radius: 2px;
  font-family: monospace;
}
.md{
  width: 100%;
  height: 100%;
  background: url('./images/reg.jpg');
  background-repeat: no-repeat;
  background-size: cover;
}
.b2 div{
  padding: 15px;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  text-transform: capitalize;
}
input[type="file"]{
  position: relative;

}
