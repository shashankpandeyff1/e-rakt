<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Donor Info Form</title>
  <link rel="stylesheet" href="/css/layout.css">
  <style>
  *{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
    body {
      font-family: Arial, sans-serif;

    }
  .main{
    display: flex;
    padding: 30px;
  }

  .main div{
    width: 50%;
    height: 100%;
  }
    form {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 400px;
    }

    label {
      font-weight: bold;
    }

    input, select, textarea {
      padding: 8px;
      font-size: 14px;
    }

    .info-display {
      display: flex;
      justify-content: space-around;
      flex-wrap: wrap;
      margin: 30px;
      gap:10px;
    }

    .info-box {
      background: #f0f0f0;
      padding: 15px;
      border-radius: 8px;
      width: calc(33% - 20px);
      box-sizing: border-box;
    }

    .info-box h4 {
      margin-bottom: 5px;
      font-size: 16px;
    }

    .info-box p {
      margin: 0;
    }
  </style>
</head>
<body>
  <header id="header">
    <h1>E-Rakt</h1>
    <ul>
      <li><a href="/"> Home</a></li>
      <li> <a href="/contactus"> Contact Us</a></li>
      <li> <a href="/donors"> Donors</a></li>
        <li><a href="/beadonor"> Be a donor</a></li>
        <li><a href="/login"> Login</a></li>
    </ul>
  </header>
<div class="main"><div>
  <h2>Donor Info Form</h2>
  <b style="color:green;">{{msg}}</b>
  <form action="/donorinfo" method="post">
    <label for="fullname">Full Name:</label>
    <input type="text" id="fullname" name="full_name" value="{{uname}}">

    <label for="age">Age:</label>
    <input type="number" id="age" name="age" value="{{age}}">

    <label for="weight">Weight:</label>
    <input type="number" id="weight" name="weight">

    <label for="bloodgroup">Blood Group:</label>
    <select id="bloodgroup" name="blood_group">
      <option>A+</option>
      <option>A-</option>
      <option>B+</option>
      <option>B-</option>
      <option>AB+</option>
      <option>AB-</option>
      <option>O+</option>
      <option>O-</option>
    </select>

    <label for="lastdonation">Last Donation:</label>
    <input type="date" id="lastdonation" name="last_donation">

    <label for="availabledate">Available Date:</label>
    <input type="date" id="availabledate" name="available_date">

    <label for="gender">Gender:</label>
    <select id="gender" name="gender">
      <option>Male</option>
      <option>Female</option>
      <option>Other</option>
    </select>

    <label for="district">District:</label>
    <input type="text" id="district" name="district">

    <label for="note">Note:</label>
    <textarea id="note" name="notes" rows="3"></textarea>
    <input type="submit" name="" value="Update Info" style="background:#ff7675;cursor:pointer;">
  </form>
</div>

  <div class="info-display">
    {{#each data}}
    <div class="info-box">
      <h4>Full Name</h4>
      <p>{{this.full_name}}</p>
    </div>
    <div class="info-box">
      <h4>Age</h4>
      <p>{{this.age}}</p>
    </div>
    <div class="info-box">
      <h4>Weight</h4>
      <p>{{this.weight}}</p>
    </div>
    <div class="info-box">
      <h4>Blood Group</h4>
      <p>{{this.blood_group}}</p>
    </div>
    <div class="info-box">
      <h4>Last Donation</h4>
      <p>{{this.last_donation}}</p>
    </div>
    <div class="info-box">
      <h4>Available Date</h4>
      <p>{{this.available_date}}</p>
    </div>
    <div class="info-box">
      <h4>Gender</h4>
      <p>{{this.gender}}</p>
    </div>
    <div class="info-box">
      <h4>District</h4>
      <p>{{this.district}}</p>
    </div>
    <div class="info-box" style="width: 100%;">
      <h4>Note</h4>
      <p>{{this.notes}}</p>
    </div>
    {{/each}}
  </div>
</div>
<footer id="footer">
  <p>© All Rights Reserved By E-Rakt</p>
</footer>
</body>
</html>
