<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <title>My Details</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      }

      body {
        background-color: #fce4ec;
        user-select: none;
      }

      nav {
        background: linear-gradient(90deg, #b71c1c, #d32f2f);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 30px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        border-bottom: 3px solid #880e4f;
        border-radius: 0 0 15px 15px;
      }

      .logo {
        color: #fff;
        font-size: 28px;
        font-weight: bold;
        letter-spacing: 1px;
        text-shadow: 1px 1px 3px #00000088;
      }

      nav ul {
        list-style: none;
        display: flex;
        gap: 20px;
      }

      nav ul li a {
        color: #fff;
        text-decoration: none;
        font-size: 16px;
        padding: 10px 16px;
        border-radius: 8px;
        transition: all 0.3s ease;
        position: relative;
      }

      nav ul li a::after {
        content: '';
        position: absolute;
        width: 0%;
        height: 3px;
        background: #fff;
        bottom: 5px;
        left: 0;
        transition: 0.4s;
      }

      nav ul li a:hover::after {
        width: 100%;
      }

      nav ul li a:hover {
        background-color: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(5px);
      }

      .logout {
        background-color: #ffc107 !important;
        color: #b71c1c !important;
        font-weight: bold !important;
      }

      .logout:hover {
        background-color: #ff9800;
        color: white;
      }

      .container {
        max-width: 600px;
        margin: 60px auto;
        background: white;
        padding: 40px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
        border-radius: 15px;
      }

      .container h2 {
        text-align: center;
        color: #b71c1c;
        margin-bottom: 30px;
      }

      .form-group {
        margin-bottom: 20px;
      }

      .form-group label {
        display: block;
        color: #333;
        margin-bottom: 6px;
      }

      .form-group input,
      .form-group textarea {
        width: 100%;
        padding: 10px;
        border: 2px solid #ddd;
        border-radius: 8px;
        transition: 0.3s;
        font-size: 16px;
      }

      .form-group input:focus,
      .form-group textarea:focus {
        border-color: #d32f2f;
        outline: none;
        background-color: #fff8f8;
      }

      .form-group textarea {
        resize: vertical;
        height: 120px;
      }

      .submit-btn {
        display: block;
        width: 100%;
        padding: 12px;
        background: #d32f2f;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 18px;
        cursor: pointer;
        transition:  0.3s ease;
      }
      footer {
        background-color: #000;
        color: white;
        text-align: center;
        padding: 25px;
        font-size: 0.95rem;
      }
      .submit-btn:hover {
        background: #b71c1c;
      }
      .donor-detail-card {
  max-width: 400px;
  margin: 30px auto;
  background: #fff0f0;
  border-radius: 16px;
  padding: 30px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
  color: #333;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  transition: transform 0.3s ease;

}

.donor-detail-card:hover {
  transform: translateY(-8px);
}

.donor-detail-card h3 {
  color: #c62828;
  font-size: 1.8rem;
  margin-bottom: 20px;
}

.donor-details p {
  font-size: 1rem;
  margin: 10px 0;
  line-height: 1.4;
}

.donor-detail-card button {
  margin-top: 20px;
  background-color: #c62828;
  color: white;
  border: none;
  padding: 12px 25px;
  border-radius: 8px;
  font-size: 1rem;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.donor-detail-card button:hover {
  background-color: #a4161a;
}

    </style>
  </head>
  <body onload="checkstatus()">
    <nav>
      <div class="logo">🩸 E-Rakt</div>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/beadonor">Account Settings</a></li>
        <li><a href="/donors">Donors</a></li>
        <li><a href="/contactus">Contact Us</a></li>
      <!--  <li class="ma"><a href="/dashboard">My Account</a></li>-->
        <li class="login"><a href="/login" class="logout">Login</a></li>
        <li class="logout1"><a href="/logout" class="logout">Logout</a></li>
      </ul>
    </nav>

    <div class="donor-detail-card">
{{#each data}}
  <h3>{{this.full_name}}</h3>
  <div class="donor-details">

    <p><strong>Weight:</strong> {{this.weight}}</p>
    <p><strong>Blood Group:</strong> {{this.blood_group}}</p>
    <p><strong>Last Donation:</strong> {{this.last_donation}}</p>
    <p><strong>Available From:</strong> {{this.available_date}}</p>
    <p><strong>Location:</strong> {{this.district}}</p>
    <p><strong>Note:</strong> {{this.notes}}</p>
{{/each}}
</div></div>

<div class="donor-detail-card">

<h3></h3>
<div class="donor-details">
{{#each ud}}
<p><strong>email</strong> {{this.mail}}</p>
<p><strong>Contact no:</strong> {{this.con}}</p>
<p><strong>DOB:</strong> {{this.dob}}</p>
<p><strong>gender:</strong> {{this.gender}}</p>
<p><strong>Emergency Contact:</strong> {{this.econ}}</p>
{{/each}}
</div>

<div class="donor-details"><h1>Your Request list:</h1>
{{#each ml}}
<p><strong>sent to:</strong> {{this.receiver}}</p>
<p><strong>blood_group:</strong> {{this.blood_group}}</p>
<p><strong>location:</strong> {{this.district}}</p>
<hr>
{{/each}}
</div>
</div><br><br><br><br><br><br><br><br><br><br>
    <p style="color:#fff;" class="ut">{{userstatus}}</p>
    <footer>
      &copy; 2025 E-Rakt. All rights reserved. Together, we save lives.
    </footer>
    <script>
      let checkstatus=()=>{
        let str=document.getElementsByClassName('ut')[0].innerHTML;
        if(str=="loggedin"){
          //alert("g")
          document.getElementsByClassName('login')[0].style.display="none";
          document.getElementsByClassName('logout')[0].style.display="block";
          document.getElementsByClassName('logout1')[0].style.display="inline";
//          document.getElementsByClassName('ma')[0].style.display="block";
  //        document.getElementsByClassName('ma')[0].style.display="inline";
        }else{
        //  alert("j")
          document.getElementsByClassName('login')[0].style.display="inline block";
          document.getElementsByClassName('logout1')[0].style.display="none";
      //    document.getElementsByClassName('ma')[0].style.display="none";
        }
      }
    </script>
  </body>
</html>
