<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Contact Us - Blood Bank</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: #fce4ec;
    }

    nav {
      background: linear-gradient(90deg, #b71c1c, #d32f2f);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 30px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.2);
      border-bottom: 3px solid #880e4f;
      border-radius: 0 0 15px 15px;
    }

    .logo {
      color: #fff;
      font-size: 28px;
      font-weight: bold;
      letter-spacing: 1px;
      text-shadow: 1px 1px 3px #00000088;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 20px;
    }

    nav ul li a {
      color: #fff;
      text-decoration: none;
      font-size: 16px;
      padding: 10px 16px;
      border-radius: 8px;
      transition: all 0.3s ease;
      position: relative;
    }

    nav ul li a::after {
      content: '';
      position: absolute;
      width: 0%;
      height: 3px;
      background: #fff;
      bottom: 5px;
      left: 0;
      transition: 0.4s;
    }

    nav ul li a:hover::after {
      width: 100%;
    }

    nav ul li a:hover {
      background-color: rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(5px);
    }

    .logout {
      background-color: #ffc107;
      color: #b71c1c;
      font-weight: bold;
    }

    .logout:hover {
      background-color: #ff9800;
      color: white;
    }

    .container {
      max-width: 600px;
      margin: 60px auto;
      background: white;
      padding: 40px;
      box-shadow: 0 0 20px rgba(0,0,0,0.1);
      border-radius: 15px;
    }

    .container h2 {
      text-align: center;
      color: #b71c1c;
      margin-bottom: 30px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      color: #333;
      margin-bottom: 6px;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 10px;
      border: 2px solid #ddd;
      border-radius: 8px;
      transition: 0.3s;
      font-size: 16px;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      border-color: #d32f2f;
      outline: none;
      background-color: #fff8f8;
    }

    .form-group textarea {
      resize: vertical;
      height: 120px;
    }

    .submit-btn {
      display: block;
      width: 100%;
      padding: 12px;
      background: #d32f2f;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 18px;
      cursor: pointer;
      transition:  0.3s ease;
    }
    footer {
      background-color: #000;
      color: white;
      text-align: center;
      padding: 25px;
      font-size: 0.95rem;
    }
    .submit-btn:hover {
      background: #b71c1c;
    }
  </style>
</head>
<body onload="checkstatus()">

  <!-- Navigation Bar -->
  <nav>
    <div class="logo">🩸 E-Rakt</div>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/beadonor">Account Settings</a></li>
      <li><a href="/donors">Donors</a></li>
      <li><a href="/contactus">Contact Us</a></li>
      <!--<li class="ma"><a href="/dashboard">My Account</a></li>-->
      <li class="login"><a href="/login" class="logout">Login</a></li>
      <li class="logout1"><a href="/logout" class="logout">Logout</a></li>
    </ul>
  </nav>
  <!-- Contact Form -->
  <div class="container">
    <b style="color:green;">{{msg}}</b>
    <h2>Contact Us</h2>
    <form action="/contact" method="post">
      <div class="form-group">
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" placeholder="Your name..." required>
      </div>

      <div class="form-group">
        <label for="email">Contact Number</label>
        <input type="tel" id="contact" name="contact" placeholder="Your number..." required>
      </div>

      <div class="form-group">
        <label for="message">Your Message</label>
        <textarea id="message" name="message" placeholder="Write your message..." required></textarea>
      </div>

      <button type="submit" class="submit-btn">Send Message</button>
    </form>
  </div>
  <p style="color:#fff;" class="ut">{{userstatus}}</p>
  <footer>
    &copy; 2025 E-Rakt. All rights reserved. Together, we save lives.
  </footer>
  <script>
    let checkstatus=()=>{
      let str=document.getElementsByClassName('ut')[0].innerHTML;
      if(str=="loggedin"){
        //alert("g")
        document.getElementsByClassName('login')[0].style.display="none";
        document.getElementsByClassName('logout')[0].style.display="block";
        document.getElementsByClassName('logout1')[0].style.display="inline";
  //      document.getElementsByClassName('ma')[0].style.display="block";
    //    document.getElementsByClassName('ma')[0].style.display="inline";
      }else{
      //  alert("j")
        document.getElementsByClassName('login')[0].style.display="inline block";
        document.getElementsByClassName('logout1')[0].style.display="none";
      //  document.getElementsByClassName('ma')[0].style.display="none";
      }
    }
  </script>
</body>
</html>
