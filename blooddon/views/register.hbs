<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <title>E-Rakt Registration</title>
    <meta name="description" content="E-Learning">
    <meta name="keywords" content="free courses,how to download free courses online ?">
    <meta name="author" content="Shashank Pandey">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="images/online-class.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cedarville+Cursive&family=Dancing+Script:wght@400;600&family=Josefin+Sans:wght@300&family=Open+Sans:wght@300&family=Oswald&family=Pacifico&family=Permanent+Marker&family=Poppins:wght@200&family=Raleway:wght@100;200&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cedarville+Cursive&family=Dancing+Script:wght@400;600&family=Josefin+Sans:wght@300&family=Noto+Sans:wght@300&family=Open+Sans:wght@300&family=Oswald&family=Pacifico&family=Permanent+Marker&family=Poppins:wght@200&family=Raleway:wght@100;200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/sreg.css">
    <link rel="stylesheet" href="/css/layout.css">
    <style media="screen">
      .barw{
        position: absolute;
        top: 15px;
        left: 15px;
        text-decoration: none;
        color: #fff;
        font-weight: bold;
        font-size: 20px;
        font-family: monospace;
        z-index: 999999999999999999999999;
      }
      *{
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
html{
  scroll-behavior: smooth;
}
body{
  overflow-x: hidden !important;
  background: #f7fbff;
  color: #17132b;
  font-family: 'Noto Sans', sans-serif;
  -webkit-user-select: none; /* Safari */
  -ms-user-select: none; /* IE 10 and IE 11 */
  user-select: none; /* Standard syntax */
}
::selection{
  background: #fb8574;
  color: #171e2b;
}
::-webkit-scrollbar {
  width: 10px;
  opacity: 0;
}

/* Track */
::-webkit-scrollbar-track {
  box-shadow: inset 0 0 5px grey;
  border-radius: 10px;
}

/* Handle */
::-webkit-scrollbar-thumb {
  background: #fb8574;
  border-radius: 10px;
}
.box{
  width: 100%;
  height: 100vh;
  display: flex;
}
.em{
  color: #fff !important;
}nav {
  background: linear-gradient(90deg, #b71c1c, #d32f2f);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 30px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  border-bottom: 3px solid #880e4f;
  border-radius: 0 0 15px 15px;
}

.logo {
  color: #fff;
  font-size: 28px;
  font-weight: bold;
  letter-spacing: 1px;
  text-shadow: 1px 1px 3px #00000088;
}

nav ul {
  list-style: none;
  display: flex;
  gap: 10px;
}

nav ul li a {
  color: #fff !important;
  text-decoration: none !important;
  font-size: 16px !important;
  padding: 10px 10px !important;
  border-radius: 8px !important;
  transition: all 0.3s ease;
  position: relative;
  text-transform: capitalize !important;
}

nav ul li a::after {
  content: '';
  position: absolute;
  width: 0%;
  height: 3px;
  background: #fff;
  bottom: 5px;
  left: 0;
  transition: 0.4s;
}

nav ul li a:hover::after {
  width: 100%;
}

nav ul li a:hover {
  background-color: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(5px);
}

.logout {
  background-color: #ffc107 !important;
  color: #b71c1c !important;
  font-weight: bold !important;
}

.logout:hover {
  background-color: #ff9800;
  color: white;
}

.b1{
  width: 60%;
  height: 100%;
  background: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}
.b1 h1{
  font-size: 36px;
  color: #fff;
  text-transform: uppercase;
  font-weight: bold;
}
.b1 p{
  font-size: 22px;
  color: #fff;
}
.b1 img{
  width: 100%;
  height: 100% !important;
  border-radius: 2px;
}
.img{
  width: 100%;
  height: 100%;
}
.txt{
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  color: #fff !important;
}
.b2{
  width: 40%;
  height: 100%;
  background: #eb4d4b;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 30px;
}
.b2 p{
  font-weight: bold;
  font-size: 14px;
}
.inp,select,input[type="date"]{
  width: 210px;
  height: 39px;
  border-radius: 3px;
  padding: 3px;
  font-size: 22px;
  color: #282828;
  font-family: monospace;
  border: 2px solid #fff;
  background: #fff;
}
.inp::placeholder,.ta::placeholder,select,input[type="date"]{
  color: #282828;
  font-size: 13px !important;
}
.ta{
  width: 410px;
  height: 80px;
  border-radius: 3px;
  padding: 4px;
  font-size: 22px;
  color: #282828;
  font-family: monospace;
  border: 2px solid #fff;
  background: #fff;
}
.sb{
  width: 160px;
  height: 44px;
  background: #fff;
  border: 2px solid #fff;
  padding: 4px;
  color: #282828;
  font-size: 20px;
  cursor: pointer;
  font-family: 'Noto Sans', sans-serif;
  font-weight: bold;
  border-radius: 3px;
}
::-webkit-file-upload-button {
background: #fff;
color: #fb8574;
border: 2px solid #fff;
}
#selbox{
  width: 210px !important;
  height: 39px;
  border-radius: 2px;
  font-family: monospace;
}
.md{
  width: 100%;
  height: 100%;
  background: url('./images/reg.jpg');
  background-repeat: no-repeat;
  background-size: cover;
}
.b2 div{
  padding: 15px;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  text-transform: capitalize;
}
input[type="file"]{
  position: relative;

}
footer {
  background-color: #000;
  color: white;
  text-align: center;
  padding: 25px;
  font-size: 0.95rem;
}
    </style>
  </head>
  <body onload="checkstatus()">
    <nav>
      <div class="logo">🩸 E-Rakt</div>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/beadonor">Account Settings</a></li>
        <li><a href="/donors">Donors</a></li>
        <li><a href="/contactus">Contact Us</a></li>
      <!--  <li class="ma"><a href="/dashboard">My Account</a></li>-->
        <li class="login"><a href="/login" class="logout">Login</a></li>
        <li class="logout1"><a href="/logout" class="logout">Logout</a></li>
      </ul>
    </nav>
    <div class="box">
      <div class="b1">
        <div class="md">
          <div class="txt">
          <h1>E-Rakt Registration</h1>
          <p>Become a Lifeline – Register Now to Save Lives!</p>
        </div>
        </div>
      </div>
      <div class="b2">
        <div>
          <form class="" action="/newdonor" method="post">
            <b style="color:#fff;">{{msg}}</b>
            <p>full name</p>
            <input type="text" name="uname" value="" placeholder="e.g shashank" maxlength="20" class="inp" required><br>
            <p class="em"></p>
            <br>
          <!--  <input type="text" name="sname" value="" placeholder="student last name" maxlength="20" class="inp"><br><br>-->
          <p>email id</p>
            <input type="email" name="mail" value="" placeholder="e.g abc@gmail.com" class="inp" required><br><p class="em"></p><br>
            <p>contact number</p>
            <input type="tel" name="con" value="" placeholder="e.g +91 8866330251" class="inp"><br><br>
            <p>your date of birth</p>
           <input type="date" name="dob" value="" placeholder="D.O.B" class="inp" required> <br><br>
           <p>gender</p>
            <select class="" name="gender" class="inp" required>
              <option value="" disabled>Select Gender</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
            </select><br><br>

            <p>emergency contact number</p>
            <input type="tel" name="econ" value="" placeholder="e.g +91 8866330252" class="inp" required><br><br>

            <input type="submit" name="" value="Register" class="sb"></div>
          </form>
      </div>
    </div><p style="color:#fff;" class="ut">{{userstatus}}</p>
    <footer>
      &copy; 2025 E-Rakt. All rights reserved. Together, we save lives.
    </footer>
    <script>
      let checkstatus=()=>{
        let str=document.getElementsByClassName('ut')[0].innerHTML;
        if(str=="loggedin"){
          //alert("g")
          document.getElementsByClassName('login')[0].style.display="none";
          document.getElementsByClassName('logout')[0].style.display="block";
          document.getElementsByClassName('logout1')[0].style.display="inline";
        //  document.getElementsByClassName('ma')[0].style.display="block";
          //document.getElementsByClassName('ma')[0].style.display="inline";
        }else{
        //  alert("j")
          document.getElementsByClassName('login')[0].style.display="inline block";
          document.getElementsByClassName('logout1')[0].style.display="none";
        //  document.getElementsByClassName('ma')[0].style.display="none";
        }

      }
    </script>
  </body>
</html>
